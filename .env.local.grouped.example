# Work2U grouped environment example
# Use this when you want the env file organized by service.

## Core
APP_BASE_URL=http://localhost:3000

## Supabase
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REDIRECT_TO=http://localhost:3000/work2u
SUPABASE_STORAGE_BUCKET_RECEIPTS=expense-receipts
SUPABASE_STORAGE_BUCKET_RECEIPTS_PUBLIC=false
WORK2U_DEFAULT_WORKSPACE_ID=

## Google OAuth / Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

## AI
GROQ_API_KEY=

## WhatsApp
WHATSAPP_WEBHOOK_SECRET=change-me

## Billplz
BILLPLZ_API_BASE_URL=https://www.billplz.com/api
BILLPLZ_COLLECTION_ID=
BILLPLZ_SECRET_KEY=
BILLPLZ_X_SIGNATURE_KEY=

## Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## Notes
# - frontend-safe values can be exposed to the client if needed
# - backend-only values must stay in server-side environment variables
# - rotate any key that has been shared publicly
