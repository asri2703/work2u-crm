# Work2U scoped environment example
# Copy to `.env.local` and fill only the sections you need.

## Public / client-safe
APP_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
SUPABASE_REDIRECT_TO=http://localhost:3000/work2u
SUPABASE_STORAGE_BUCKET_RECEIPTS=expense-receipts
SUPABASE_STORAGE_BUCKET_RECEIPTS_PUBLIC=false
WORK2U_DEFAULT_WORKSPACE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
BILLPLZ_API_BASE_URL=https://www.billplz.com/api
BILLPLZ_COLLECTION_ID=
STRIPE_PUBLISHABLE_KEY=

## Server only
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
WHATSAPP_WEBHOOK_SECRET=change-me
BILLPLZ_SECRET_KEY=
BILLPLZ_X_SIGNATURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## Feature toggles / optional connectors
# Set these only when the feature is live.
# - Google Calendar / Gmail syncing
# - AI drafting and assistant help
# - WhatsApp webhook / QR connector
# - Billplz billing for Malaysia
# - Stripe billing for global users
